/// The claim this task makes is that a project with external jars documents instead of
/// failing, so it is proven against a real javadoc run over a source that cannot compile
/// without the classpath - not only against the option array.
///
/// The dependency is a compiled directory rather than a jar: a directory is a classpath
/// entry javadoc accepts on the same terms, and building a jar here would test `writeJar`
/// a second time instead of the classpath.
void classpathJavadocAssertions(Path root, Path staging) throws Exception {
    var library = root.resolve("library");
    var external = library.resolve("lib");
    Files.createDirectories(external);
    Files.writeString(external.resolve("External.java"), """
            package lib;

            public class External {
                public String value() {
                    return "external";
                }
            }
            """);
    var classes = root.resolve("classes");
    Files.createDirectories(classes);
    compile(library, classes);
    var dependent = root.resolve("dependent");
    var consumer = dependent.resolve("demo");
    Files.createDirectories(consumer);
    Files.writeString(consumer.resolve("Consumer.java"), """
            package demo;

            import lib.External;

            public class Consumer {
                public String pass(External external) {
                    return external.value();
                }
            }
            """);
    assertFailure("javadoc failed",
            "without the classpath the unresolved import fails the run, which is the case this task removes",
            () -> javadocJar(staging, "2.0.0", dependent));
    var jar = javadocJar(staging, "2.0.0", dependent, List.of(classes));
    assertTrue(entryNames(jar).contains("demo/Consumer.html"),
            "with the classpath the same source documents and is packaged");
}

/// Only ever used to produce a classpath entry for [#classpathJavadocAssertions]; the
/// production path never compiles anything, because zb already did.
void compile(Path sources, Path target) throws Exception {
    var javac = ToolProvider.findFirst("javac").orElseThrow(this::missingJavadocTool);
    var options = new ArrayList<>(List.of("-d", target.toString()));
    options.addAll(javaSources(sources));
    var output = new StringWriter();
    var writer = new PrintWriter(output);
    var status = javac.run(writer, writer, options.toArray(String[]::new));
    writer.flush();
    if (status != 0) {
        throw new IllegalStateException(
                "the selftest fixture failed to compile:%n%s".formatted(output.toString().strip()));
    }
}

/// A jar staged under a coordinate whose version it does not carry is the one defect a
/// publish cannot take back: a Central version is immutable.
void jarVersionAssertions() throws Exception {
    var root = temporaryDirectory("zpublish-jar-version-selftest");
    var versioned = fixtureJar(root.resolve("versioned/zb.jar"), "1.0.0");
    assertEquals(Optional.of("1.0.0"), jarVersion(versioned), "the packaged version.txt is read back");
    assertEquals(Optional.empty(), jarVersion(fixtureJar(root.resolve("bare/zb.jar"), null)),
            "a jar carrying no version metadata reports none");
