record Answer(int statusCode, String body) {}

record Call(String method, String query, String authorization, String contentType, byte[] body) {}

/// Answers a scripted sequence and records what it was sent. Without it the upload and
/// the polling loop would first execute against the real Portal, where a mistake in the
/// request shape costs an immutable version.
record ScriptedPortal(Deque<Answer> answers, List<Call> calls) implements HttpHandler {

    @Override
    public void handle(HttpExchange exchange) throws IOException {
        this.calls.add(received(exchange));
        answer(exchange, next());
    }

    /// The final answer repeats, so a poll that is meant to time out does not have to be
    /// scripted a fixed number of times.
    Answer next() {
        if (this.answers.isEmpty()) {
            return new Answer(500, "no scripted answer");
        }
        if (this.answers.size() == 1) {
            return this.answers.getFirst();
        }
        return this.answers.removeFirst();
    }

    Call received(HttpExchange exchange) throws IOException {
        return new Call(exchange.getRequestMethod(),
                String.valueOf(exchange.getRequestURI().getQuery()),
                String.valueOf(exchange.getRequestHeaders().getFirst("Authorization")),
                String.valueOf(exchange.getRequestHeaders().getFirst("Content-Type")),
                exchange.getRequestBody().readAllBytes());
    }

    void answer(HttpExchange exchange, Answer answer) throws IOException {
        var bytes = answer.body().getBytes(StandardCharsets.UTF_8);
        exchange.sendResponseHeaders(answer.statusCode(), bytes.length);
        try (var body = exchange.getResponseBody()) {
            body.write(bytes);
        }
    }
}

ScriptedPortal portal(List<Call> calls, Answer... answers) {
    return new ScriptedPortal(new ArrayDeque<>(List.of(answers)), calls);
}

