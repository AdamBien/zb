            "the mismatch names the project root the version could come from",
            () -> checkedJarVersion(versioned, "2.0.0"));
}

/// [#assertFailure] takes a `Callable`, so the void guard is wrapped rather than given a
/// return value it has no use for. The jar sits one directory below the fixture root, so
/// the guard is handed the locations a run from that root would probe.
Path checkedJarVersion(Path jar, String version) throws Exception {
    var root = jar.getParent().getParent();
    requireJarVersion(jar, version, versionFileLocations(root, root.resolve("src/main/resources")));
    return jar;
}

/// A real zip: the production path reads the built jar's own version back out, so a
/// placeholder text file would no longer stand in for it.
Path fixtureJar(Path target, String version) throws Exception {
    var content = target.getParent().resolve("content");
    Files.createDirectories(content);
    Files.writeString(content.resolve("marker.txt"), "stands in for the compiled classes");
    if (version != null) {
        Files.writeString(content.resolve(versionFileName), version + "\n");
    }
    writeJar(target, List.of(content));
    return target;
}

Path manifestJar(Path target, String version) throws Exception {
    var content = target.getParent().resolve("content");
    Files.createDirectories(content.resolve("META-INF"));
    Files.writeString(content.resolve("META-INF/MANIFEST.MF"),
            "Manifest-Version: 1.0%nImplementation-Version: %s%n%n".formatted(version));
    writeJar(target, List.of(content));
    return target;
}

