/// The signing loop itself, driven by a stub in place of `gpg`. Everything below the
/// command builder — artifact selection, the passphrase written to stdin, the exit-code
/// check and the `true` that tells [#validate] to require a `.asc` per artifact — is only
/// ever reached on a real publish otherwise, against an immutable Central version.
///
/// A `/bin/sh` stub rather than a generated key: a `gpg --quick-generate-key` in the
/// selftest would need entropy, a temporary `GNUPGHOME` and a gpg on the machine, and
/// none of that is what this asserts.
void signingLoopAssertions(String secret) throws Exception {
    if (!Files.isExecutable(Path.of("/bin/sh"))) {
        return;
    }
    var root = temporaryDirectory("zpublish-signing-loop-selftest");
    var staging = root.resolve("staging");
    Files.createDirectories(staging);
    for (var suffix : List.of(jarSuffix, pomSuffix, sourcesSuffix, javadocSuffix)) {
        Files.writeString(staging.resolve(artifactName("1.0.0", suffix)), "artifact bytes");
    }
    Files.writeString(staging.resolve(artifactName("1.0.0", jarSuffix) + ".md5"), "a checksum");
    var seen = root.resolve("stdin.txt");
    var stub = stubGpg(root.resolve("gpg-stub.sh"),
            "cat > '%s'\nfor argument in \"$@\"; do last=\"$argument\"; done\n: > \"$last.asc\""
                    .formatted(seen));
    var previous = gpgExecutable;
    try {
        gpgExecutable = stub.toString();
        assertTrue(sign(staging, false, signer("0xDEADBEEF", secret)),
                "a configured key signs rather than skipping, so validate demands a signature per artifact");
        assertEquals(secret + "\n", Files.readString(seen),
                "the passphrase reaches gpg on stdin, newline-terminated and nowhere else");
        for (var suffix : List.of(jarSuffix, pomSuffix, sourcesSuffix, javadocSuffix)) {
            assertTrue(Files.exists(staging.resolve(artifactName("1.0.0", suffix) + ".asc")),
                    "every staged artifact is signed: " + suffix);
        }
        assertFalse(Files.exists(staging.resolve(artifactName("1.0.0", jarSuffix) + ".md5.asc")),
                "a checksum is not an artifact and is not signed");
        assertFalse(Files.exists(staging.resolve(artifactName("1.0.0", jarSuffix) + ".asc.asc")),
                "a signature is never signed a second time");
        var failing = stubGpg(root.resolve("gpg-failing.sh"), "cat > /dev/null; echo 'bad passphrase'; exit 2");
        gpgExecutable = failing.toString();
        assertFailure("gpg failed with exit code 2", "a non-zero gpg exit ends the run",
                () -> sign(staging, false, signer("0xDEADBEEF", secret)));
        assertFailure("bad passphrase", "gpg's own output is reported rather than swallowed",
                () -> sign(staging, false, signer("0xDEADBEEF", secret)));
        gpgExecutable = root.resolve("no-such-gpg").toString();
        assertFailure("gpg is not available", "a gpg that is not on the PATH is named, not stack-traced",
                () -> sign(staging, false, signer("0xDEADBEEF", secret)));
    } finally {
        gpgExecutable = previous;
    }
}

Path stubGpg(Path file, String body) throws Exception {
    Files.writeString(file, "#!/bin/sh\n%s\n".formatted(body));
    file.toFile().setExecutable(true);
    return file;
}

/// Writes the `.asc` beside the last argument and nothing else, so a run whose environment
/// happens to carry `ZPUBLISH_GPG_*` stages exactly what a run without them stages.
Path signingStub(Path file) throws Exception {
    return stubGpg(file,
            "cat > /dev/null\nfor argument in \"$@\"; do last=\"$argument\"; done\n: > \"$last.asc\"");
}

