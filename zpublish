            () -> checkedOptions("-dryrun"));
    assertFailure("unknown option", "an unrecognised flag never reaches the publish path",
            () -> checkedOptions("-unknown"));
    assertEquals("2026.01.01.1", optionValue(args("-version-string", "2026.01.01.1"), "-version-string"),
            "the operand follows the flag");
    assertEquals(null, optionValue(args("-dry-run"), "-version-string"),
            "an absent flag has no operand");
    assertEquals("", optionValue(args("-dry-run", "-version-string"), "-version-string"),
            "a flag left last on the command line yields an empty operand");
    assertEquals("-automatic", optionValue(args("-version-string", "-automatic"), "-version-string"),
            "the operand is taken verbatim, flag-looking or not");
