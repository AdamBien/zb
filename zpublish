void multipartAssertions() throws Exception {
    var content = "zip bytes".getBytes(StandardCharsets.UTF_8);
    var parts = multipart(multipartBoundary, "bundle.zip", content);
    assertEquals(3, parts.size(), "preamble, file bytes and epilogue");
    assertEquals("zip bytes", new String(parts.get(1), StandardCharsets.UTF_8),
            "the zip bytes travel between the two text parts untouched");
    assertContains(multipartContentType(multipartBoundary), multipartBoundary,
            "the boundary appears in the Content-Type header");
    var body = new String(join(parts), StandardCharsets.UTF_8);
    assertContains(body, "--%s\r\n".formatted(multipartBoundary),
            "the same boundary opens the body");
    assertContains(body, "name=\"bundle\"", "the single part is named bundle");
    assertContains(body, "filename=\"bundle.zip\"", "the part carries the bundle file name");
    assertContains(body, "Content-Type: application/octet-stream\r\n\r\n",
            "a blank line separates the part headers from the payload");
    assertTrue(body.endsWith("\r\n--%s--\r\n".formatted(multipartBoundary)),
            "the body terminates with the closing boundary");
    assertEquals(2, occurrences(body, "--" + multipartBoundary),
            "the boundary occurs exactly twice: opening and closing");
    assertFalse(body.replace("\r\n", "").contains("\n"),
            "every delimiter is CRLF, never a bare newline");
    boundaryCollisionAssertions();
}

/// The upload picks its boundary from the payload rather than assuming one, so the two
/// answers it can give are asserted: the ordinary bundle keeps the readable default, and a
/// payload that happens to carry it gets a boundary that occurs nowhere inside the bytes.
void boundaryCollisionAssertions() throws Exception {
    var ordinary = "zip bytes".getBytes(StandardCharsets.UTF_8);
    assertEquals(multipartBoundary, boundaryFor(ordinary),
            "a payload the boundary does not occur in is sent under the default boundary");
    var colliding = ("head\r\n--%s\r\ntail".formatted(multipartBoundary))
            .getBytes(StandardCharsets.UTF_8);
    var chosen = boundaryFor(colliding);
    assertFalse(multipartBoundary.equals(chosen),
            "a payload carrying the default boundary is not sent under it");
    assertFalse(occurs(colliding, chosen),
            "the chosen boundary occurs nowhere in the payload it delimits");
    var body = new String(join(multipart(chosen, "bundle.zip", colliding)),
            StandardCharsets.ISO_8859_1);
    assertEquals(2, occurrences(body, "--" + chosen),
            "the chosen boundary still opens and closes the body exactly twice");
    assertTrue(occurs(colliding, multipartBoundary),
            "the collision fixture really does carry the default boundary");
    assertFalse(occurs(ordinary, multipartBoundary),
            "an ordinary payload really does not");
    assertFalse(occurs("zpublishBundleBoundar".getBytes(StandardCharsets.UTF_8), multipartBoundary),
            "a payload ending one byte short of the boundary is not a match");
}

