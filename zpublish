    assertEquals(1, pastFloor.size(),
            "names past the floor align too, which the fixed column they outran did not");
    assertTrue(pastFloor.getFirst() > insideFloor.getFirst(),
            "the column widened to the longer names instead of letting them push past it");
    assertFailure("zb-1.0.0.jar.asc", "an unsigned tree fails validation naming the signatures",
            () -> validated(unsigned, true));
    var incomplete = complete(root.resolve("incomplete"), "1.0.0", true);
    for (var file : derivedFiles(incomplete.resolve(artifactName("1.0.0", javadocSuffix)))) {
        Files.delete(file);
    }
    Files.delete(incomplete.resolve(artifactName("1.0.0", javadocSuffix)));
    assertEquals(List.of("zb-1.0.0-javadoc.jar"), missing(incomplete, true),
            "a missing required artifact is named, and its absent derived files are not");
    assertFailure("incomplete", "an incomplete tree fails validation",
            () -> validated(incomplete, true));
    assertFailure("zb-1.0.0-javadoc.jar", "the failure names the missing artifact",
            () -> validated(incomplete, true));
    Files.delete(incomplete.resolve(artifactName("1.0.0", pomSuffix) + checksumSuffix("MD5")));
    assertEquals(List.of("zb-1.0.0.pom.md5", "zb-1.0.0-javadoc.jar"), missing(incomplete, true),
            "a missing checksum is named alongside the missing artifact");
    var orphaned = complete(root.resolve("orphaned"), "1.0.0", true);
    var jar = orphaned.resolve(artifactName("1.0.0", jarSuffix));
    for (var file : checksumFiles(jar)) {
        Files.delete(file);
    }
    Files.delete(jar);
    assertTrue(isOrphan(signatureFile(jar)), "a signature without its artifact is an orphan");
    assertFalse(isOrphan(signatureFile(orphaned.resolve(artifactName("1.0.0", pomSuffix)))),
            "a signature beside its artifact is not an orphan");
    assertEquals(List.of("zb-1.0.0.jar", "zb-1.0.0.jar.asc has no artifact"), missing(orphaned, true),
            "an orphaned signature is reported next to the artifact it outlived");
    assertFailure("has no artifact", "an orphaned signature fails validation",
            () -> validated(orphaned, true));
}

String syntheticArtifact = "not a real artifact, but a real file";

/// A staging tree carrying the four artifacts Central requires, each with its checksums
/// and, when `signed`, a stand-in detached signature.
Path complete(Path root, String version, boolean signed) throws Exception {
    var staging = root.resolve("com/airhacks/zb").resolve(version);
    Files.createDirectories(staging);
    for (var suffix : requiredSuffixes) {
        var artifact = staging.resolve(artifactName(version, suffix));
        Files.writeString(artifact, syntheticArtifact);
        writeChecksums(artifact);
        if (signed) {
            Files.writeString(signatureFile(artifact), "-----BEGIN PGP SIGNATURE-----");
        }
    }
    return staging;
}

/// The distinct column the size field ends at, across the report's artifact lines. One
/// element means every line agrees; a second element *is* the misalignment, so the
/// assertion states the property instead of counting spaces at a magic offset.
List<Integer> sizeColumns(String report) {
    return report.lines()
            .skip(1)
            .map(line -> line.indexOf(" bytes"))
            .distinct()
            .toList();
}

/// [#assertFailure] takes a `Callable`, so the void validator is wrapped rather than
/// given a return value it has no use for.
Path validated(Path staging, boolean signed) throws Exception {
    validate(staging, signed);
    return staging;
}

