        var staged = stage(testMetadata, "1.0.0");
        assertEquals(stagingDirectory(stagingRoot, testMetadata, "1.0.0"), staged,
                "the version is staged at its Maven repository path");
        assertFalse(Files.exists(stale.getParent()),
                "a version staged by an earlier run is dropped, never bundled alongside this one");
        assertEquals(List.of("zb-1.0.0-javadoc.jar", "zb-1.0.0-sources.jar", "zb-1.0.0.jar",
                "zb-1.0.0.pom"), fileNames(staged),
                "the production path stages the four artifacts Central requires");
        builtJar = root.resolve("absent.jar");
        assertFailure("%s not found: build %s first, then publish"
                .formatted(root.resolve("absent.jar"), root.resolve("absent.jar")),
                "the production path names the fix when the jar was never built",
                () -> stage(testMetadata, "1.0.0"));
        assertEquals(List.of("zb-1.0.0-javadoc.jar", "zb-1.0.0-sources.jar", "zb-1.0.0.jar",
                "zb-1.0.0.pom"), fileNames(staged),
                "a run started without a build leaves the previous staging tree in place");
        builtJar = fixtureJar(root.resolve("stale-build/zb.jar"), "0.9.0");
        assertFailure("carries version [0.9.0] but would be published as [1.0.0]",
                "the production path refuses a jar built from another version",
                () -> stage(testMetadata, "1.0.0"));
