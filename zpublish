    Files.createDirectories(flat.resolve("src"));
    Files.createDirectories(flat.resolve("resources"));
    assertEquals(flat.resolve("src"), sourcesDirectory(flat),
            "src is the second rung when src/main/java is absent");
    assertEquals(flat.resolve("resources"), resourcesDirectory(flat),
            "resources is the second rung when src/main/resources is absent");
    var bare = directory.resolve("bare");
    Files.createDirectories(bare.resolve("src/main/java"));
    assertEquals(bare.resolve("src/main/resources"), resourcesDirectory(bare),
