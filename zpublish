byte[] join(List<byte[]> parts) throws Exception {
    var buffer = new ByteArrayOutputStream();
    for (var part : parts) {
        buffer.write(part);
    }
    return buffer.toByteArray();
}

List<String> fileNames(Path directory) throws Exception {
    try (var files = Files.list(directory)) {
        return files.map(Path::getFileName)
                .map(Path::toString)
                .sorted()
                .toList();
    }
}

/// A jar is a zip, so `ZipFile` reads the sources jar, the javadoc jar and the bundle
/// alike — and unlike `JarFile` it does not care that the bundle carries no manifest.
List<String> entryNames(Path archive) throws Exception {
    try (var file = new ZipFile(archive.toFile())) {
        return file.stream()
                .map(ZipEntry::getName)
                .toList();
    }
}

byte[] entryBytes(Path archive, String entry) throws Exception {
    try (var file = new ZipFile(archive.toFile())) {
        return file.getInputStream(file.getEntry(entry)).readAllBytes();
    }
}

int occurrences(String text, String fragment) {
    return text.split(Pattern.quote(fragment), -1).length - 1;
}

