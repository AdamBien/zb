/// built `zbo/zb.jar` nor javadoc the real `src/main/java`.
void stagingRootAssertions(Path root, Path sources, Path resources) throws Exception {
    var previousRoot = stagingRoot;
    var previousJar = builtJar;
    var previousSources = sourceDirectory;
    var previousResources = resourceDirectory;
    try {
        stagingRoot = root.resolve("production-staging");
        builtJar = fixtureJar(root.resolve("production-build/zb.jar"), "1.0.0");
        sourceDirectory = sources;
        resourceDirectory = resources;
        var stale = stagingDirectory(stagingRoot, testMetadata, "0.9.0")
