        assertTrue(Files.exists(project.resolve("build/bundle.zip")),
                "the dry run bundled, so validate ran before the bundle rather than after it");
        assertContains(Files.readString(staging.resolve("widget-1.0.0.pom"), StandardCharsets.UTF_8),
                "<groupId>org.example</groupId>",
                "the staged POM carries the sibling's coordinate, not this repository's");

        // A version the built jar does not carry has to end the run at stage(), before
        // anything is written and long before the Portal is addressed.
        Files.deleteIfExists(project.resolve("build/bundle.zip"));
        assertFailure("would be published as [2.0.0]",
                "a version the built jar does not carry ends the run before it stages",
                () -> {
                    publish("-dry-run", "-version-string", "2.0.0");
                    return "published";
                });
        assertFalse(Files.exists(project.resolve("build/bundle.zip")),
                "a run that fails at stage() leaves no bundle behind");
        assertEquals(List.of(), calls, "a failed run reaches the Portal not once either");

        // The hazard the two-level lookup would otherwise carry, run end to end: a complete
        // `~/.zpublish` left over from another project beside a project with none of its own
        // must end the run, not publish this jar under the global coordinates.
        var localConfiguration = project.resolve(configurationFileName);
        var configured = Files.readString(localConfiguration, StandardCharsets.UTF_8);
        Files.writeString(home.resolve(configurationFileName), configured, StandardCharsets.UTF_8);
        Files.delete(localConfiguration);
        assertFailure(configurationFileName,
                "a complete global configuration never publishes a project that has none",
                () -> {
                    publish("-dry-run", "-version-string", "1.0.0");
                    return "published";
                });
        assertFalse(Files.exists(project.resolve("build/bundle.zip")),
                "the run that found no local configuration staged nothing");
        Files.writeString(localConfiguration, configured, StandardCharsets.UTF_8);
        Files.delete(home.resolve(configurationFileName));

        assertFailure("-nonsense", "an unrecognised option is refused before anything is staged",
                () -> {
                    publish("-nonsense");
                    return "published";
                });
    } finally {
        server.stop(0);
        projectRoot = previousRoot;
        buildFile = previousBuildFile;
        homeDirectory = previousHome;
        uploadEndpoint = previousUpload;
        statusEndpoint = previousStatus;
        gpgExecutable = previousGpg;
        outputDirectory = previousPaths.get(0);
        stagingRoot = previousPaths.get(1);
        bundleFile = previousPaths.get(2);
        builtJar = previousPaths.get(3);
        sourceDirectory = previousPaths.get(4);
        resourceDirectory = previousPaths.get(5);
        classpath = previousClasspath;
    }
}

/// `ZB_` catches the environment variables this tool was born with: a message telling a
/// sibling project to set `ZB_GPG_KEY_ID` names a variable that no longer exists.
List<String> projectSpecificLiterals = List.of("java -jar", "zb.jar", "build zb",
        "zb project", "com.airhacks", "AdamBien", "ZB_");

/// A copy of this file in another project has to be able to explain its own failures.
/// Every failure a publishing run can raise before it reaches the network is raised here
/// against a fixture that has nothing to do with this repository, and each message is
/// checked twice: that it names the path the run actually resolved, and that it carries
/// none of the literals a hardcoded project leaves behind.
///
/// The list below is the whole pre-network throw surface: [#requireBuiltJar],
/// [#jarVersion], [#requireJarVersion], [#buildConfiguration], [#missingVersion],
/// [#skipSigning], [#credentials(String,String)], [#requireSourcesBelowRoot],
/// [#requireConfiguration], [#requireSourceDirectory], [#requireCoordinate],
/// [#requireMavenVersion], [#validate], [#requireStagedArtifacts], [#missingJavadocTool]
/// and [#gpg(List)]. A message added below one of those has to be added here too, or the
/// genericity this branch exists for is enforced over a third of the surface.
void messageAssertions() throws Exception {
    var root = temporaryDirectory("zpublish-message-selftest");
    var locations = versionFileLocations(root, root.resolve("resources"));
    var built = fixtureJar(root.resolve("build/widget.jar"), "0.9.0");
    var absent = root.resolve("build/never-built.jar");
    var text = root.resolve("build/not-a-jar.jar");
    Files.writeString(text, "a real file that is not a zip");
    var absentBuildFile = root.resolve("elsewhere/.zb");

    var missingJar = thrownMessage(() -> {
        requireBuiltJar(absent);
        return absent;
    });
    assertContains(missingJar, absent.toString(), "the missing-jar message names the resolved jar");
    var unreadable = thrownMessage(() -> jarVersion(text));
    assertContains(unreadable, text.toString(), "the unreadable-jar message names the resolved jar");
    var mismatch = thrownMessage(() -> {
        requireJarVersion(built, "1.0.0", locations);
        return built;
    });
    assertContains(mismatch, built.toString(), "the version-mismatch message names the resolved jar");
    assertContains(mismatch, locations,
            "the version-mismatch message names where the version has to be written");
    var missingBuildFile = thrownMessage(() -> buildConfiguration(absentBuildFile));
    assertContains(missingBuildFile, absentBuildFile.toString(),
            "the missing-.zb message names the file it looked for");
    assertContains(missingBuildFile, name, "the missing-.zb message names the tool, not a project");
    var missingVersion = thrownMessage(() -> missingVersion(root, root.resolve("resources")));
    assertContains(missingVersion, versionEnvironmentVariable,
            "the missing-version message names the override this tool reads");
    var unsigned = thrownMessage(() -> skipSigning(false));
    assertContains(unsigned, keyIdEnvironmentVariable,
            "the unsigned-publish message names the signing variables this tool reads");
    var unauthorized = thrownMessage(() -> credentials(null, null));
    assertContains(unauthorized, tokenUserEnvironmentVariable,
            "the missing-credentials message names the token variables this tool reads");
    var rootSources = thrownMessage(() -> requireSourcesBelowRoot(root, root));
    assertContains(rootSources, sourceCandidates.getFirst(),
            "the root-sources message names the directory to move the sources to");
    var missingKeys = thrownMessage(() -> metadata(new Properties(), testConfigurationLocations));
    assertContains(missingKeys, configurationFileName,
            "the missing-metadata message names the file the keys belong in");
    var missingSources = thrownMessage(() -> {
        requireSourceDirectory(root.resolve("no-such-sources"));
        return root;
    });
    assertContains(missingSources, name,
            "the missing-sources message names the tool, not a project");
    var badCoordinate = thrownMessage(() -> requireCoordinate("groupId", ".."));
    var badVersion = thrownMessage(() -> requireMavenVersion("../escape"));
    var emptyStaging = root.resolve("empty-staging");
    Files.createDirectories(emptyStaging);
    var sibling = metadata(completeConfiguration(), testConfigurationLocations);
    var incomplete = thrownMessage(() -> {
        validate(sibling, emptyStaging, false);
        return emptyStaging;
    });
    var emptyBundle = thrownMessage(() -> bundle(emptyStaging, root.resolve("b.zip")));
    var noJavadoc = missingJavadocTool().getMessage();
    var noGpg = thrownMessage(() -> gpg(List.of(root.resolve("no-such-gpg").toString())));
    assertContains(noGpg, keyIdEnvironmentVariable,
            "the missing-gpg message names the variables that turn signing off");

    for (var message : List.of(missingJar, unreadable, mismatch, missingBuildFile, missingVersion,
            unsigned, unauthorized, rootSources, missingKeys, missingSources, badCoordinate,
            badVersion, incomplete, emptyBundle, noJavadoc, noGpg)) {
        for (var literal : projectSpecificLiterals) {
            assertExcludes(message, literal, "no production message carries a hardcoded project");
        }
    }
    assertTrue(projectSpecificLiterals.stream()
            .anyMatch("build zb first with `java -jar zb.jar`, then publish"::contains),
            "the literal list catches the messages this replaced");
    assertTrue(projectSpecificLiterals.stream()
            .anyMatch("set ZB_GPG_KEY_ID and ZB_GPG_PASSPHRASE before publishing"::contains),
            "the literal list catches the environment variables this renamed");
    assertContains(thrownMessage(() -> {
        throw new IllegalStateException("boom");
    }), "boom", "the thrown message is what is asserted on");
    assertContains(thrownMessage(() -> "staged"), "no failure",
            "an action that does not throw is reported rather than read as a message");
}

/// [#assertFailure] asserts a fragment is present, and an absent fragment needs the
/// message as a value: an action that never throws has to read as a failed expectation
/// rather than as an empty message that trivially excludes everything.
String thrownMessage(Callable<?> action) {
    try {
        return "no failure, the action returned [%s]".formatted(action.call());
    } catch (Exception problem) {
        return String.valueOf(problem.getMessage());
    }
}

void assertExcludes(String actual, String unexpectedFragment, String message) {
    this.assertions++;
    if (actual.contains(unexpectedFragment)) {
        this.failures.add("%s: [%s] appears in [%s]".formatted(message, unexpectedFragment, actual));
    }
}

void assertEquals(Object expected, Object actual, String message) {
    this.assertions++;
    if (!Objects.equals(expected, actual)) {
        this.failures.add("%s: expected [%s] but was [%s]".formatted(message, expected, actual));
    }
}

void assertContains(String actual, String expectedFragment, String message) {
    this.assertions++;
    if (!actual.contains(expectedFragment)) {
        this.failures.add("%s: [%s] is missing from [%s]".formatted(message, expectedFragment, actual));
    }
}

void assertTrue(boolean actual, String message) {
    this.assertions++;
    if (!actual) {
        this.failures.add("%s: expected true but was false".formatted(message));
    }
}

void assertFalse(boolean actual, String message) {
    this.assertions++;
    if (actual) {
        this.failures.add("%s: expected false but was true".formatted(message));
    }
}

/// Error paths are asserted on the thrown message rather than on an exit code — the
/// harness runs in the same JVM, so a `System.exit` in the tested code would kill it.
void assertFailure(String expectedFragment, String message, Callable<?> action) {
    this.assertions++;
    try {
        var result = action.call();
        this.failures.add("%s: expected a failure containing [%s] but got [%s]"
                .formatted(message, expectedFragment, result));
    } catch (Exception problem) {
        var thrown = String.valueOf(problem.getMessage());
        if (!thrown.contains(expectedFragment)) {
            this.failures.add("%s: expected a failure containing [%s] but was [%s]"
                    .formatted(message, expectedFragment, thrown));
        }
    }
}

void summary() {
    if (this.failures.isEmpty()) {
        IO.println("%s: selftest passed (%d assertions)".formatted(name, this.assertions));
        return;
    }
    System.err.println(String.join(System.lineSeparator(), this.failures));
    System.err.println("%s: selftest failed (%d of %d assertions)"
            .formatted(name, this.failures.size(), this.assertions));
    System.exit(1);
}
