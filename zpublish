/// The list decides whether an answer ends the run or is asked again, and by the time it is
/// consulted the bundle is already uploaded. Adding `401` to it would poll an expired token
/// to the ceiling and then send the operator to the Portal for a deployment that was never
/// accepted; dropping `502` would abort a run over one edge proxy hiccup.
void retryClassificationAssertions() {
    for (var retryable : retryableStatusCodes) {
        assertTrue(isRetryable(retryable), "a transient answer is asked again: " + retryable);
    }
    for (var terminal : List.of(200, 201, 400, 401, 403, 404, 409, 422)) {
        assertFalse(isRetryable(terminal),
                "an answer that does not become true by asking again ends the poll: " + terminal);
    }
}

void settlementAssertions(String base) throws Exception {
    statusEndpoint = base + "/failed";
    assertFailure("already published", "a duplicate version is reported as immutable, not as a bug",
            () -> polled(userManagedPublishing));
    // The ceiling is the USER_MANAGED one and PUBLISHING alone outlasts it: this settles
    // only because the loop stops insisting on VALIDATED once Central moves past it.
    statusEndpoint = base + "/released";
    userManagedPollCeiling = Duration.ofMillis(200);
    assertEquals("settled", polled(userManagedPublishing),
            "a USER_MANAGED deployment released by hand mid-poll settles at PUBLISHED");
    // AUTOMATIC is the mode that cannot be undone, and it is the only one that has to poll
    // *through* VALIDATED: a run that stopped there would report a release Central has not
    // made yet.
    statusEndpoint = base + "/automatic";
    var previousAutomaticCeiling = automaticPollCeiling;
    try {
        automaticPollCeiling = Duration.ofMillis(500);
        assertEquals("settled", polled(automaticPublishing),
                "an AUTOMATIC deployment polls past VALIDATED and settles at PUBLISHED");
    } finally {
        automaticPollCeiling = previousAutomaticCeiling;
    }
    statusEndpoint = base + "/unauthorized";
    assertFailure("status query", "a 401 ends the poll rather than being asked again until the ceiling",
            () -> polled(userManagedPublishing));
    assertFailure("the token has expired", "Central's own reason for refusing the poll is reported",
            () -> polled(userManagedPublishing));
    statusEndpoint = base + "/pending";
    pollInterval = Duration.ofMillis(20);
    userManagedPollCeiling = Duration.ofMillis(50);
    assertFailure("it is not lost", "a deployment that never settles points at the Portal",
            () -> polled(userManagedPublishing));
}

