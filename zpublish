/// The endpoints are fields precisely so they can be redirected here.
void portalAssertions() throws Exception {
    var uploadCalls = new ArrayList<Call>();
    var statusCalls = new ArrayList<Call>();
    var server = HttpServer.create(new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);
    server.createContext("/upload", portal(uploadCalls,
            new Answer(201, sampleDeploymentId + System.lineSeparator()),
            new Answer(502, "Central is unavailable")));
    server.createContext("/status", portal(statusCalls,
            new Answer(503, "bad gateway"),
            new Answer(200, statusBody("PENDING")),
            new Answer(200, statusBody(validatedState))));
    server.createContext("/failed", portal(new ArrayList<>(),
            new Answer(200, duplicateFailureBody)));
    server.createContext("/pending", portal(new ArrayList<>(),
            new Answer(200, statusBody("PENDING"))));
    server.createContext("/released", portal(new ArrayList<>(),
            new Answer(200, statusBody(publishingState)),
            new Answer(200, statusBody(publishedState))));
    server.createContext("/automatic", portal(new ArrayList<>(),
            new Answer(200, statusBody("PENDING")),
            new Answer(200, statusBody(validatedState)),
            new Answer(200, statusBody(publishingState)),
            new Answer(200, statusBody(publishedState))));
    server.createContext("/unauthorized", portal(new ArrayList<>(),
            new Answer(401, "the token has expired")));
    server.start();
    var previousUpload = uploadEndpoint;
    var previousStatus = statusEndpoint;
    var previousInterval = pollInterval;
    var previousCeiling = userManagedPollCeiling;
    try {
        var base = "http://%s:%d".formatted(server.getAddress().getHostString(),
                server.getAddress().getPort());
        uploadEndpoint = base + "/upload";
        statusEndpoint = base + "/status";
        pollInterval = Duration.ofMillis(1);
        uploadCallAssertions(uploadCalls);
        pollAssertions(statusCalls);
        settlementAssertions(base);
    } finally {
        server.stop(0);
        uploadEndpoint = previousUpload;
        statusEndpoint = previousStatus;
        pollInterval = previousInterval;
        userManagedPollCeiling = previousCeiling;
    }
}

