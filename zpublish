            "Implementation-Version is the fallback when version.txt was not packaged");
    assertEquals(versioned, checkedJarVersion(versioned, "1.0.0"),
            "a jar built from the version being published passes");
    assertFailure("carries version [1.0.0] but would be published as [2.0.0]",
            "a jar built from another version is never published",
            () -> checkedJarVersion(versioned, "2.0.0"));
    assertFailure("carries version [none]", "a jar carrying no version is refused too",
            () -> checkedJarVersion(fixtureJar(root.resolve("bare-again/zb.jar"), null), "1.0.0"));
    var text = root.resolve("plain.txt");
