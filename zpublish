/// Prose is escaped where a coordinate is rejected. An apostrophe in a name and an
/// ampersand in a description are ordinary English, and a publisher that failed on them
/// would leave the user with nothing to change but the truth.
void escapedPomAssertions() throws Exception {
    var awkward = configurationWith("developer.name", "Adam O'Brien & Co");
    awkward.setProperty("description", "packages jars & documents <everything>");
    var escaped = pom(metadata(awkward, testConfigurationLocations), "2.0.0");
    assertContains(escaped, "packages jars &amp; documents &lt;everything&gt;",
            "an ampersand and markup in prose are escaped rather than rejected");
    assertContains(escaped, "Adam O'Brien &amp; Co",
            "an apostrophe is left as it reads while the ampersand beside it is escaped");
    assertEquals("packages jars & documents <everything>", parsedText(escaped, "description"),
            "the escaped description parses back to exactly what was configured");
    assertEquals("Adam O'Brien & Co", parsedText(escaped, "developers/developer/name"),
            "the escaped developer name parses back to exactly what was configured");
    assertEquals("widget", parsedText(escaped, "artifactId"),
            "a POM carrying escaped prose is still a document a parser can load");
    assertEquals("a sibling project",
            parsedText(pom(metadata(completeConfiguration(), testConfigurationLocations), "2.0.0"),
                    "description"),
            "prose needing no escaping reaches the POM unchanged");
    illegalCharacterAssertions();
}

/// The line between "escape it" and "refuse it" is what XML can carry at all. An ampersand
/// has a spelling; a `NUL` or a `BEL` has none, and a POM carrying one is a document no
/// parser will load - which a dry run has to say now rather than Central saying it against a
/// version that can never be published again.
void illegalCharacterAssertions() throws Exception {
    // Assembled from code points rather than written out: a source file carrying the
    // invisible byte under test is a file every editor is free to clean up again.
    var control = "broken" + (char) 0x01 + "text";
    assertFailure("U+0001", "a control character in prose is refused rather than escaped",
            () -> pom(metadata(configurationWith("description", control),
                    testConfigurationLocations), "2.0.0"));
    assertFailure("description", "the refusal names the field carrying the character",
            () -> pom(metadata(configurationWith("description", control),
                    testConfigurationLocations), "2.0.0"));
    var formFeed = "wid" + (char) 0x0C + "get";
    assertFailure("U+000C", "a form feed is as unpublishable as a NUL",
            () -> pom(metadata(configurationWith("name", formFeed),
                    testConfigurationLocations), "2.0.0"));
    var lonelySurrogate = "Adam " + (char) 0xD800 + "Bien";
    assertFailure("U+D800", "an unpaired surrogate is caught as the broken input it is",
            () -> pom(metadata(configurationWith("developer.name", lonelySurrogate),
                    testConfigurationLocations), "2.0.0"));
    assertEquals("first\nsecond",
            parsedText(pom(metadata(configurationWith("description", "first\nsecond"),
                    testConfigurationLocations), "2.0.0"), "description"),
            "the three control characters XML does admit stay ordinary text");
    var supplementary = "ships " + new String(Character.toChars(0x1F680)) + " daily";
    assertEquals(supplementary,
            parsedText(pom(metadata(configurationWith("description", supplementary),
                    testConfigurationLocations), "2.0.0"), "description"),
            "a surrogate pair is one legal character, not two illegal ones");
    assertEquals("clean &amp; escaped", xmlText("description", "clean & escaped"),
            "prose carrying nothing illegal is escaped exactly as before");
}

/// Parsed with a real XML parser rather than matched as a string. An unescaped ampersand
/// still reads fine as a fragment; only a parser answers the question that decides an
/// immutable release - whether Central's reader can load the document at all.
String parsedText(String pom, String path) throws Exception {
    var document = DocumentBuilderFactory.newInstance()
            .newDocumentBuilder()
            .parse(new ByteArrayInputStream(pom.getBytes(StandardCharsets.UTF_8)));
    var element = document.getDocumentElement();
    for (var tag : path.split("/")) {
        element = child(element, tag);
    }
    return element.getTextContent();
}

/// Descends child by child rather than calling `getElementsByTagName`, because `<name>`
/// appears three times in a POM and the flat lookup would silently answer about the
/// project where the question was about the developer.
Element child(Element parent, String tag) {
    var children = parent.getChildNodes();
    for (var index = 0; index < children.getLength(); index++) {
        if (children.item(index) instanceof Element element && tag.equals(element.getTagName())) {
            return element;
        }
    }
    throw new IllegalStateException("no <%s> below <%s>".formatted(tag, parent.getTagName()));
}

