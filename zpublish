    assertEquals(Optional.empty(), signer("0xDEADBEEF", "  "), "a blank passphrase disables signing");
    assertEquals(Optional.of(new Signer("0xDEADBEEF", secret)), signer("  0xDEADBEEF  ", secret),
            "a configured key id is trimmed");
    assertFailure(keyIdEnvironmentVariable, "a publish without a key names ZPUBLISH_GPG_KEY_ID",
