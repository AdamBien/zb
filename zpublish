/// Both layouts are reached by discovery, not by a misconfiguration: a project with `src`
/// but no `src/main/java` takes `src` off the sources ladder, and the resources ladder is
/// free to land either inside it or beside it.
void overlappingRootAssertions(Path root) throws Exception {
    var nested = root.resolve("nested");
    var nestedResources = nested.resolve("main/resources");
    Files.createDirectories(nested.resolve("demo"));
    Files.createDirectories(nestedResources);
    Files.writeString(nested.resolve("demo/Sample.java"), "package demo;");
    Files.writeString(nestedResources.resolve("version.txt"), "1.0.0");
    assertEquals(List.of(nested), roots(nested, nestedResources),
            "a resource root inside the source root is packaged once, by the walk over the source root");
    var nestedJar = sourcesJar(root.resolve("nested-staging"), "1.0.0", nested, nestedResources);
    assertEquals(1, occurrences(String.join("\n", entryNames(nestedJar)), "version.txt"),
            "the nested resource is not packaged a second time under a shortened entry name");
    assertTrue(entryNames(nestedJar).contains("main/resources/version.txt"),
            "the nested resource keeps the name the source-root walk gives it");
    var sibling = root.resolve("sibling");
    var siblingSources = sibling.resolve("src");
    var siblingResources = sibling.resolve("resources");
    Files.createDirectories(siblingSources);
    Files.createDirectories(siblingResources);
    Files.writeString(siblingSources.resolve("app.properties"), "from the source root");
    Files.writeString(siblingResources.resolve("app.properties"), "from the resource root");
    assertEquals(List.of(siblingSources, siblingResources), roots(siblingSources, siblingResources),
            "disjoint roots are both packaged");
    assertFailure("would be packaged twice",
            "two roots carrying the same relative path are refused by name, not by a raw ZipException",
            () -> sourcesJar(root.resolve("sibling-staging"), "1.0.0", siblingSources, siblingResources));
    assertFailure("app.properties", "the refusal names the entry that collided",
            () -> sourcesJar(root.resolve("sibling-staging"), "1.0.0", siblingSources, siblingResources));
}

boolean isAbsoluteEntry(String entry) {
    return entry.startsWith("/") || entry.startsWith("\\");
}

