            }
            """);
    Files.writeString(project.resolve(".zb"), "jar.dir=build/\njar.file.name=widget.jar\n");
    Files.writeString(project.resolve(".zpublish"), """
            groupId=org.example
            artifactId=widget
            name=widget
            description=a sibling project that never heard of zb
            url=https://example.org/widget
            license.name=MIT License
            developer.id=sibling
            developer.name=Sibling Maintainer
            scm.url=https://example.org/widget
